{
	"compilerOptions": {
		// required
		"allowSyntheticDefaultImports": true,
		"jsx": "react",
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"module": "commonjs",
		"moduleResolution": "Node",
		"noLib": true,
		"resolveJsonModule": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": [
			"node_modules/@rbxts",
			"node_modules/@flamework"
		],
		"plugins": [
		{
			"transform": "rbxts-transformer-flamework"
		}
		],

		// configurable
		"rootDir": "src",
		"outDir": "out",
		"baseUrl": "src",
		"incremental": true,
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo",
		"ignoreDeprecations": "5.0"
	},
	// The test runner's config lives at the repo root, outside `rootDir`. It is consumed by the Jest
	// Roblox CLI's own loader, never by this compiler, so it is excluded from the program rather than
	// being folded into `src` — it is not game code.
	"exclude": ["jest.config.ts"]
}
